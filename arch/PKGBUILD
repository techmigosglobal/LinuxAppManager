pkgname=linux-app-manager
pkgver=0.1.0
pkgrel=1
pkgdesc='Safe cross-source Linux software manager'
arch=('x86_64' 'aarch64')
url='https://github.com/techmigosglobal/LinuxAppManager'
license=('GPL-3.0-or-later')
depends=('python-gobject' 'gtk4' 'libadwaita' 'polkit')
makedepends=('cargo>=1.90' 'rust>=1.90')
source=('linux-app-manager::git+https://github.com/techmigosglobal/LinuxAppManager.git#tag=v0.1.0')
sha256sums=('SKIP')

build() {
  cd "$srcdir/linux-app-manager"
  cargo build --release --locked --bin lam
}

package() {
  cd "$srcdir/linux-app-manager"
  install -Dm755 target/release/lam "$pkgdir/usr/lib/linux-app-manager/lam"
  install -Dm755 gui/app.py "$pkgdir/usr/lib/linux-app-manager/app.py"
  install -Dm755 packaging/linux-app-manager "$pkgdir/usr/bin/linux-app-manager"
  install -Dm644 packaging/io.github.techmigosglobal.LinuxAppManager.desktop "$pkgdir/usr/share/applications/io.github.techmigosglobal.LinuxAppManager.desktop"
  install -Dm644 packaging/io.github.techmigosglobal.LinuxAppManager.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.techmigosglobal.LinuxAppManager.metainfo.xml"
  install -Dm644 packaging/io.github.techmigosglobal.LinuxAppManager.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.techmigosglobal.LinuxAppManager.svg"
  install -Dm644 packaging/io.github.techmigosglobal.LinuxAppManager.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.techmigosglobal.LinuxAppManager.png"
}
